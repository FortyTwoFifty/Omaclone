#!/usr/bin/env bash
set +o history 2>/dev/null || true
unset HISTFILE
set +x +v
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
export NAS_BACKUP_ROOT="$ROOT"
mkdir -p "$HOME/.local/bin"
export PATH="$HOME/.local/bin:$PATH"

source "$ROOT/scripts/lib.sh"
source "$ROOT/scripts/locations.sh"
source "$ROOT/scripts/backend.sh"
source "$ROOT/scripts/tui.sh"

usage() {
  cat <<'EOF'
omaclone — clone an Omarchy identity to NAS, extra disk, or S3-compatible cloud

Usage:
  omaclone setup [secrets|continue]  First-run or resume wizard; secrets reconfigures the password source
  omaclone clone [--cron]        Save an identity clone (alias: backup)
  omaclone restore [--same-machine] [--snapshot ID] [--blank-omarchy] [--delete]
  omaclone snapshots
  omaclone forget [ID...] [--all] [--yes]
  omaclone status [--json|--ack]     Show last clone, size, keep plan, location connected
  omaclone install               PATH command, user timers, bar plugin
  omaclone uninstall             Remove PATH command, timers, and plugin symlink
  omaclone check
  omaclone init                  restic init on the configured repo
  omaclone prune
  omaclone retention [set PRESET] [--yes]
  omaclone location              List clone locations
  omaclone location switch [ID]  Make a location active
  omaclone location add          Register another NAS / disk / cloud
  omaclone location remove [ID]  Forget a location (does not erase the drive)
  omaclone location schedule [ID] [on|off]
                                 Show or set daily clones for a location
  omaclone doctor                Check destination, uid mapping, repo path
  omaclone estimate              Approximate size of $HOME after excludes
  omaclone verify [--all]        restic check (1/10 of packs, or all)
  omaclone copy [ID]             Copy clones to another mounted location
  omaclone --version             Print plugin version
EOF
}

ensure_transport() {
  local cron=0
  [[ "${1:-}" == --cron ]] && cron=1
  local backend
  backend=$(config_get transport.backend)
  [[ -n "$backend" ]] || die "no transport configured; run: omaclone setup"
  if (( cron )); then
    local loc sched
    loc=$(location_active_id)
    sched=$(location_get "$loc" schedule on)
    if [[ "$sched" == off ]]; then
      location_schedule_apply "$loc"
      write_last_result skip "Automatic clones are off for this location"
      log "skipping: location '$loc' is not scheduled"
      exit 0
    fi
  fi
  if nas_backup_backend_run transport "$backend" ready; then
    return 0
  fi
  if (( cron )) && nas_backup_transport_has "$backend" removable; then
    local uuid
    uuid=$(config_get transport.uuid)
    if [[ -z "$uuid" || ! -e "/dev/disk/by-uuid/$uuid" ]]; then
      write_last_result skip "Clone disk is not connected"
      notify "Omaclone skipped" "Plug in the clone disk and it will run next time." low
      log "skipping: clone disk is not connected"
      exit 0
    fi
  fi
  if ! nas_backup_backend_run transport "$backend" mount; then
    if (( cron )); then
      if [[ "$backend" == s3 ]]; then
        write_last_result skip "S3 access keys are not available (unlock keyring)" password
        notify "Omaclone skipped" "The last clone did not run because S3 keys were not available." low
        log "skipping: S3 credentials are not available"
        exit 0
      fi
      write_last_result skip "Clone location is not mounted"
      notify "Omaclone skipped" "Mount the clone location and it will run next time." low
      log "skipping: clone location is not mounted"
      exit 0
    fi
    die "transport '$backend' is not ready"
  fi
  nas_backup_backend_run transport "$backend" ready || die "transport '$backend' is not ready"
}

finish_transport() {
  local backend
  backend=$(config_get transport.backend)
  [[ -n "$backend" ]] || return 0
  nas_backup_backend_run transport "$backend" post-restic 2>/dev/null || true
}


source "$ROOT/scripts/cmd-setup.sh"
source "$ROOT/scripts/cmd-clone.sh"
source "$ROOT/scripts/cmd-restore.sh"
source "$ROOT/scripts/cmd-status.sh"

backfill_destination_profile() {
  if [[ -z "$(config_get retention.preset)" && -n "$(config_get transport.backend)" ]]; then
    config_set retention.preset standard
  fi
  [[ -z "$(config_get destination.profile)" ]] || return 0
  local t
  t=$(config_get transport.backend)
  case "$t" in
    nfs|cifs|sftp) config_set destination.profile nas ;;
    disk) config_set destination.profile disk ;;
    s3) config_set destination.profile cloud ;;
    local) config_set destination.profile local ;;
  esac
}

main() {
  local cmd="${1:-}"
  shift || true
  backfill_destination_profile
  migrate_locations
  location_sync_active
  case "$cmd" in
    setup) cmd_setup "$@" ;;
    doctor) cmd_doctor "$@" ;;
    backup|clone) cmd_backup "$@" ;;
    restore) cmd_restore "$@" ;;
    snapshots) cmd_snapshots "$@" ;;
    forget|remove) cmd_forget "$@" ;;
    status) cmd_status "$@" ;;
    install) cmd_install "$@" ;;
    uninstall) cmd_uninstall "$@" ;;
    check) cmd_check "$@" ;;
    init) cmd_init "$@" ;;
    prune) cmd_prune "$@" ;;
    wait-keyring) cmd_wait_keyring "$@" ;;
    retention) cmd_retention "$@" ;;
    location|locations) cmd_location "$@" ;;
    estimate) cmd_estimate "$@" ;;
    verify) cmd_verify "$@" ;;
    copy) cmd_copy "$@" ;;
    -h|--help|help|"") usage ;;
    --version|version|-V)
      python3 - "$ROOT/manifest.json" <<'PY'
import json, sys
from pathlib import Path
print(json.loads(Path(sys.argv[1]).read_text(encoding="utf-8")).get("version", "0"))
PY
      ;;
    *) die "unknown command: $cmd" ;;
  esac
}

main "$@"
