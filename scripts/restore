#!/usr/bin/env bash
set +o history 2>/dev/null || true
unset HISTFILE
set +x +v
set -euo pipefail

here=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
plugin="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/plugins/omaclone.plugin"
self=$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "$here/restore")

if [[ -x "$plugin/scripts/omaclone" ]]; then
  ROOT="$plugin"
elif [[ -x "$here/omaclone/scripts/omaclone" ]]; then
  ROOT="$here/omaclone"
elif [[ -x "$here/scripts/omaclone" ]]; then
  ROOT="$here"
else
  echo "omaclone: could not find the tool tree next to $0" >&2
  echo "Expected $here/omaclone/scripts/omaclone or $plugin/scripts/omaclone" >&2
  exit 1
fi

# Project Ed25519 public key (config/omaclone-kit.pub). Not taken from the kit.
_KIT_PUBKEY_PEM='-----BEGIN PUBLIC KEY-----
MCowBQYDK2VwAyEAxmJomSkS0fDbZLxJA6YNjedgar61rjmWrZJJD3icr0k=
-----END PUBLIC KEY-----
'

_kit_is_copy() {
  [[ -f "$here/SHA256SUMS" || -f "$here/.omaclone-bootstrap" || -f "$here/omaclone/config/omaclone-kit.sig" ]]
}

# Verify the kit tree with the embedded public key before any other kit code runs.
_kit_signature_ok() {
  local payload="$1"
  python3 - "$payload" "$_KIT_PUBKEY_PEM" <<'PY'
import hashlib, os, subprocess, sys, tempfile
from pathlib import Path

root = Path(sys.argv[1])
pub = sys.argv[2]
skip = {"omaclone-kit.sig", "TREE.sig"}
namespace = b"omaclone-kit-v1\n"
digest = hashlib.sha256()
digest.update(namespace)
rels = []
for base in ("scripts", "backends", "config"):
    directory = root / base
    if not directory.is_dir():
        continue
    for path in sorted(directory.rglob("*")):
        if not path.is_file() or "__pycache__" in path.parts or path.suffix == ".pyc":
            continue
        if path.name in skip:
            continue
        rels.append(path.relative_to(root).as_posix())
for rel in rels:
    data = (root / rel).read_bytes()
    digest.update(rel.encode("utf-8") + b"\0" + data + b"\0")
want = digest.hexdigest().encode("ascii")
sig_path = root / "config" / "omaclone-kit.sig"
if not sig_path.is_file():
    raise SystemExit(1)
sig = sig_path.read_bytes()
if not (32 <= len(sig) <= 256):
    raise SystemExit(1)
digest_tmp = sig_tmp = pub_tmp = None
try:
    with tempfile.NamedTemporaryFile(delete=False) as tmp:
        tmp.write(want)
        digest_tmp = tmp.name
    with tempfile.NamedTemporaryFile(delete=False) as tmp:
        tmp.write(sig)
        sig_tmp = tmp.name
    with tempfile.NamedTemporaryFile("w", delete=False, encoding="utf-8") as tmp:
        tmp.write(pub if pub.endswith("\n") else pub + "\n")
        pub_tmp = tmp.name
    proc = subprocess.run(
        ["openssl", "pkeyutl", "-verify", "-pubin", "-inkey", pub_tmp, "-rawin", "-in", digest_tmp, "-sigfile", sig_tmp],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    raise SystemExit(0 if proc.returncode == 0 else 1)
finally:
    for p in (digest_tmp, sig_tmp, pub_tmp):
        if p:
            try:
                os.unlink(p)
            except OSError:
                pass
PY
}

if _kit_is_copy && [[ "${OMACLONE_ALLOW_UNTRUSTED_KIT:-}" != 1 ]]; then
  payload="$ROOT"
  [[ -d "$here/omaclone/scripts" ]] && payload="$here/omaclone"
  if ! _kit_signature_ok "$payload"; then
    echo "omaclone: kit is missing a valid project signature (the USB/NAS copy may have been changed)." >&2
    echo "Install from git: omarchy plugin add https://github.com/FortyTwoFifty/Omaclone.git --enable" >&2
    echo "Set OMACLONE_ALLOW_UNTRUSTED_KIT=1 only if you accept running unsigned kit code." >&2
    exit 1
  fi
fi

if [[ -f "$here/config.toml" ]]; then
  if [[ "${OMACLONE_TEST:-}" != 1 && -t 0 && -t 1 ]]; then
    echo "This USB/NAS copy includes a destination in $here/config.toml." >&2
    echo "Only continue if you trust this copy's host or bucket." >&2
    printf 'Type TRUST to use it: ' >&2
    read -r phrase
    [[ "$phrase" == TRUST ]] || { echo "aborted. Install the plugin from git and run: omaclone restore" >&2; exit 1; }
  fi
  export NAS_BACKUP_CONFIG="$here/config.toml"
elif [[ -f "$(dirname "$ROOT")/config.toml" ]]; then
  export NAS_BACKUP_CONFIG="$(dirname "$ROOT")/config.toml"
fi

need_pkgs=(restic jq gum rsync)
transport=""
if [[ -n "${NAS_BACKUP_CONFIG:-}" && -f "$NAS_BACKUP_CONFIG" ]]; then
  transport=$(python3 "$ROOT/scripts/config.py" "$NAS_BACKUP_CONFIG" get transport.backend "")
fi

case "$transport" in
  nfs) need_pkgs+=(nfs-utils) ;;
  cifs) need_pkgs+=(cifs-utils) ;;
  sftp) need_pkgs+=(openssh) ;;
  s3|disk|local|"") ;;
esac

missing=()
for p in restic jq gum rsync; do
  command -v "$p" >/dev/null 2>&1 || missing+=("$p")
done
case "$transport" in
  nfs)
    command -v mount.nfs4 >/dev/null 2>&1 || command -v mount.nfs >/dev/null 2>&1 || missing+=(nfs-utils)
    ;;
  cifs)
    command -v mount.cifs >/dev/null 2>&1 || missing+=(cifs-utils)
    ;;
esac

if ((${#missing[@]})); then
  echo "Installing: ${missing[*]}"
  sudo pacman -S --needed --noconfirm "${missing[@]}"
fi

export NAS_BACKUP_ROOT="$ROOT"
[[ -x "$ROOT/scripts/omaclone" ]] || { echo "omaclone: missing $ROOT/scripts/omaclone" >&2; exit 1; }
exec "$ROOT/scripts/omaclone" restore "$@"
