#!/usr/bin/env bash
set +o history 2>/dev/null || true
unset HISTFILE
set +x +v
set -euo pipefail

cmd="${1:-}"
cfg() { python3 "$NAS_BACKUP_ROOT/scripts/config.py" "$NAS_BACKUP_CONFIG" get "$1" "${2:-}"; }

# Kernel key retention only. The D-Bus Secret Service backend
# (PROTON_PASS_LINUX_KEYRING=dbus) writes the default GNOME keyring; on
# Omarchy that file is unencrypted INI, and any rewrite can make
# gnome-keyring refuse to load it.
export PROTON_PASS_LINUX_KEYRING=kernel

id() { printf '%s\n' pass-cli; }
describe() { printf '%s\n' "Proton Pass (pass-cli)"; }

available() {
  command -v pass-cli >/dev/null 2>&1
}

setup() {
  local vault item field
  vault=$(cfg secrets.vault "Personal")
  item=$(cfg secrets.item "Omaclone")
  field=$(cfg secrets.field password)
  if command -v gum >/dev/null 2>&1; then
    vault=$(gum input --placeholder "Proton Pass vault" --value "$vault" </dev/tty)
    item=$(gum input --placeholder "Proton Pass item title" --value "$item" </dev/tty)
    field=$(gum input --placeholder "Field name" --value "$field" </dev/tty)
  fi
  python3 "$NAS_BACKUP_ROOT/scripts/config.py" "$NAS_BACKUP_CONFIG" set secrets.backend pass-cli
  python3 "$NAS_BACKUP_ROOT/scripts/config.py" "$NAS_BACKUP_CONFIG" set secrets.vault "$vault"
  python3 "$NAS_BACKUP_ROOT/scripts/config.py" "$NAS_BACKUP_CONFIG" set secrets.item "$item"
  python3 "$NAS_BACKUP_ROOT/scripts/config.py" "$NAS_BACKUP_CONFIG" set secrets.field "$field"
}

get() {
  local vault item field
  vault=$(cfg secrets.vault "Personal")
  item=$(cfg secrets.item "Omaclone")
  field=$(cfg secrets.field password)
  if ! pass-cli info >/dev/null; then
    printf '%s\n' 'Proton Pass is not signed in. Use Sign in from the setup menu, or: pass-cli login' >&2
    exit 1
  fi
  pass-cli item view --vault-name "$vault" --item-title "$item" --field "$field"
}

unlock() {
  if pass-cli info >/dev/null; then
    printf '%s\n' 'Proton Pass is already signed in' >&2
    return 0
  fi
  pass-cli login </dev/tty >/dev/tty 2>/dev/tty
}

update() {
  if ! command -v pass-cli >/dev/null 2>&1; then
    install
    return $?
  fi
  local tty_present=0
  [[ -e /dev/tty ]] && tty_present=1
  if (( tty_present )); then
    pass-cli update -y </dev/tty >/dev/tty 2>/dev/tty
  else
    pass-cli update -y
  fi
}

install() {
  if command -v pass-cli >/dev/null 2>&1; then
    return 0
  fi
  printf '%s\n' "Proton Pass CLI (pass-cli) is not installed." >&2
  printf '%s\n' "Install it from https://proton.me/pass/cli then re-run: omaclone setup" >&2
  return 1
}

put() {
  printf '%s\n' "pass-cli backend does not write to Proton Pass" >&2
  exit 2
}

brief() {
  local f="$NAS_BACKUP_ROOT/briefs/secrets-pass-cli.txt"
  [[ -f "$f" ]] && cat "$f"
  return 0
}

case "$cmd" in
  id) id ;;
  describe) describe ;;
  available) available ;;
  setup) setup ;;
  get) get ;;
  unlock) unlock ;;
  update) update ;;
  put) put ;;
  install) install ;;
  brief) brief ;;
  *) printf 'unknown verb: %s\n' "$cmd" >&2; exit 2 ;;
esac
