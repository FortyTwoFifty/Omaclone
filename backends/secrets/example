#!/usr/bin/env bash
set +o history 2>/dev/null || true
unset HISTFILE
set +x +v
set -euo pipefail

cmd="${1:-}"
cfg() { python3 "$NAS_BACKUP_ROOT/scripts/config.py" "$NAS_BACKUP_CONFIG" get "$1" "${2:-}"; }

id() { printf '%s\n' example; }
describe() { printf '%s\n' "Example secret backend (not for production)"; }
available() { exit 1; }
install() { return 0; }
setup() { python3 "$NAS_BACKUP_ROOT/scripts/config.py" "$NAS_BACKUP_CONFIG" set secrets.backend example; }

get() {
  printf '%s\n' "implement: fetch the restic password here" >&2
  exit 1
}

put() { exit 2; }

unlock() { exit 2; }

case "$cmd" in
  id) id ;;
  describe) describe ;;
  available) available ;;
  install) install ;;
  setup) setup ;;
  get) get ;;
  unlock) unlock ;;
  put) put ;;
  *) exit 2 ;;
esac
