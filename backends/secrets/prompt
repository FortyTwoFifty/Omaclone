#!/usr/bin/env bash
set +o history 2>/dev/null || true
unset HISTFILE
set +x +v
set -euo pipefail

cmd="${1:-}"

id() { printf '%s\n' prompt; }

describe() {
  printf '%s\n' "Paste each time (nothing stored)"
}

available() { exit 0; }

install() { return 0; }

setup() {
  python3 "$NAS_BACKUP_ROOT/scripts/config.py" "$NAS_BACKUP_CONFIG" set secrets.backend prompt
  printf '%s\n' "Prompt backend selected. The restic password will be asked at each backup/restore and is never saved." >&2
}

put() {
  printf '%s\n' "prompt backend does not store passwords" >&2
  exit 2
}

get() {
  if [[ ! -t 0 && ! -e /dev/tty ]]; then
    printf '%s\n' "prompt backend needs a terminal" >&2
    exit 1
  fi
  if ! command -v gum >/dev/null 2>&1; then
    printf '%s\n' "gum is required to paste a password safely" >&2
    exit 1
  fi
  local pw
  pw=$(gum input --password --placeholder "Restic password (not saved)" </dev/tty) || exit 1
  printf '%s' "$pw"
  unset pw
}

case "$cmd" in
  id) id ;;
  describe) describe ;;
  available) available ;;
  install) install ;;
  setup) setup ;;
  get) get ;;
  put) put ;;
  *) printf 'unknown verb: %s\n' "$cmd" >&2; exit 2 ;;
esac
