#!/usr/bin/env bash
set +o history 2>/dev/null || true
unset HISTFILE
set +x +v
set -euo pipefail

cmd="${1:-}"
cfg() { python3 "$NAS_BACKUP_ROOT/scripts/config.py" "$NAS_BACKUP_CONFIG" get "$1" "${2:-}"; }

id() { printf '%s\n' keyring; }
describe() { printf '%s\n' "GNOME Keyring (secret-tool)"; }

available() {
  command -v secret-tool >/dev/null 2>&1
}

setup() {
  python3 "$NAS_BACKUP_ROOT/scripts/config.py" "$NAS_BACKUP_CONFIG" set secrets.backend keyring
  if ! command -v gum >/dev/null 2>&1; then
    printf '%s\n' "keyring backend selected. Store the password with: omaclone setup" >&2
    return 0
  fi
  if gum confirm "Store the restic password in the keyring now?"; then
    while true; do
      local pw pw2
      pw=$(gum input --password --placeholder "Restic password" </dev/tty)
      pw2=$(gum input --password --placeholder "Confirm restic password" </dev/tty)
      if [[ "$pw" == "$pw2" ]]; then
        printf '%s' "$pw" | secret-tool store --label="omaclone restic" service omaclone attribute restic-password
        unset pw pw2
        break
      fi
      printf '%s\n' "passwords did not match" >&2
      if gum confirm "Skip storing a password for now?"; then
        return 0
      fi
    done
  fi
}

get() {
  secret-tool lookup service omaclone attribute restic-password 2>/dev/null && return 0
  secret-tool lookup service omarchy-backup attribute restic-password 2>/dev/null && return 0
  secret-tool lookup service nas-backup attribute restic-password
}

install() {
  if command -v secret-tool >/dev/null 2>&1; then
    return 0
  fi
  source "$NAS_BACKUP_ROOT/scripts/deps.sh" || true
  deps_ensure_pacman libsecret secret-tool
}

put() {
  secret-tool store --label="omaclone restic" service omaclone attribute restic-password
}

case "$cmd" in
  id) id ;;
  describe) describe ;;
  available) available ;;
  setup) setup ;;
  get) get ;;
  put) put ;;
  install) install ;;
  *) printf 'unknown verb: %s\n' "$cmd" >&2; exit 2 ;;
esac
