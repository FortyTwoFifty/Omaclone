#!/usr/bin/env bash
set +o history 2>/dev/null || true
unset HISTFILE
set +x +v
set -euo pipefail

cmd="${1:-}"
cfg() { python3 "$NAS_BACKUP_ROOT/scripts/config.py" "$NAS_BACKUP_CONFIG" get "$1" "${2:-}"; }
store() { python3 "$NAS_BACKUP_ROOT/scripts/keyring_store.py" "$@"; }

id() { printf '%s\n' keyring; }
describe() { printf '%s\n' "GNOME Keyring (Omaclone collection)"; }

available() {
  store available >/dev/null 2>&1
}

setup() {
  python3 "$NAS_BACKUP_ROOT/scripts/config.py" "$NAS_BACKUP_CONFIG" set secrets.backend keyring
  if ! command -v gum >/dev/null 2>&1; then
    printf '%s\n' "keyring backend selected. Store the password with: omaclone setup" >&2
    return 0
  fi
  printf '%s\n' "Omaclone keeps secrets in its own GNOME Keyring collection, not the default desktop keyring." >&2
  printf '%s\n' "That collection password is not your FIDO key and not the restic repository password unless you reused the same string." >&2
  if ! OMACLONE_KEYRING_CREATE=1 store ensure; then
    if command -v gum >/dev/null 2>&1 && gum confirm "Recreate the Omaclone keyring? Stored restic/S3 secrets in it will be forgotten."; then
      local kpw kpw2
      kpw=$(gum input --password --placeholder "NEW Omaclone keyring password (empty allowed)" </dev/tty)
      kpw2=$(gum input --password --placeholder "Confirm keyring password" </dev/tty)
      if [[ "$kpw" != "$kpw2" ]]; then
        printf '%s\n' "keyring passwords did not match" >&2
        return 1
      fi
      printf '%s' "$kpw" | store recreate || return 1
      unset kpw kpw2
    else
      return 1
    fi
  fi
  if gum confirm "Store the restic password in the keyring now?"; then
    while true; do
      local pw pw2
      pw=$(gum input --password --placeholder "Restic password" </dev/tty)
      pw2=$(gum input --password --placeholder "Confirm restic password" </dev/tty)
      if [[ "$pw" == "$pw2" ]]; then
        printf '%s' "$pw" | store put restic-password --label "omaclone restic"
        unset pw pw2
        break
      fi
      printf '%s\n' "passwords did not match" >&2
      if gum confirm "Skip storing a password for now?"; then
        return 0
      fi
    done
  fi
}

get() {
  store get restic-password
}

install() {
  if store available >/dev/null 2>&1; then
    return 0
  fi
  source "$NAS_BACKUP_ROOT/scripts/deps.sh" || true
  echo "Installing libsecret python-gobject …" >&2
  sudo pacman -S --needed --noconfirm libsecret python-gobject || {
    printf '%s\n' "failed to install libsecret/python-gobject — re-run: omaclone setup" >&2
    return 1
  }
}

put() {
  store put restic-password --label "omaclone restic"
}

case "$cmd" in
  id) id ;;
  describe) describe ;;
  available) available ;;
  setup) setup ;;
  get) get ;;
  put) put ;;
  install) install ;;
  recreate) store recreate ;;
  *) printf 'unknown verb: %s\n' "$cmd" >&2; exit 2 ;;
esac
