#!/usr/bin/env bash
set +o history 2>/dev/null || true
unset HISTFILE
set +x +v
set -euo pipefail

cmd="${1:-}"
cfg() { python3 "$NAS_BACKUP_ROOT/scripts/config.py" "$NAS_BACKUP_CONFIG" get "$1" "${2:-}"; }

id() { printf '%s\n' 1password; }
describe() { printf '%s\n' "1Password (op CLI)"; }

available() {
  command -v op >/dev/null 2>&1
}

setup() {
  local vault item field
  vault=$(cfg secrets.vault "Private")
  item=$(cfg secrets.item "Omaclone")
  field=$(cfg secrets.field password)
  if command -v gum >/dev/null 2>&1; then
    vault=$(gum input --placeholder "1Password vault" --value "$vault" </dev/tty)
    item=$(gum input --placeholder "1Password item title" --value "$item" </dev/tty)
    field=$(gum input --placeholder "Field name" --value "$field" </dev/tty)
  fi
  python3 "$NAS_BACKUP_ROOT/scripts/config.py" "$NAS_BACKUP_CONFIG" set secrets.backend 1password
  python3 "$NAS_BACKUP_ROOT/scripts/config.py" "$NAS_BACKUP_CONFIG" set secrets.vault "$vault"
  python3 "$NAS_BACKUP_ROOT/scripts/config.py" "$NAS_BACKUP_CONFIG" set secrets.item "$item"
  python3 "$NAS_BACKUP_ROOT/scripts/config.py" "$NAS_BACKUP_CONFIG" set secrets.field "$field"
}

get() {
  local vault item field ref
  vault=$(cfg secrets.vault)
  item=$(cfg secrets.item)
  field=$(cfg secrets.field password)
  [[ -n "$vault" && -n "$item" ]] || {
    printf '%s\n' "secrets.vault and secrets.item must be set" >&2
    exit 1
  }
  if ! op account get >/dev/null && ! op whoami >/dev/null; then
    printf '%s\n' '1Password CLI is not signed in. Use Sign in from the setup menu, or: op signin' >&2
    exit 1
  fi
  ref="op://${vault}/${item}/${field}"
  op read "$ref"
}

unlock() {
  if op account get >/dev/null || op whoami >/dev/null; then
    printf '%s\n' '1Password is already signed in' >&2
    return 0
  fi
  op signin </dev/tty >/dev/tty 2>/dev/tty
}

update() {
  source "$NAS_BACKUP_ROOT/scripts/deps.sh" || true
  deps_ensure_pacman unzip
  mkdir -p "$HOME/.local/bin"
  local arch version zip_url dest tmpdir
  arch=$(_deps_arch_map)
  version=$(curl -fsSL "https://app-updates.agilebits.com/check/1/0/CLI2/en/2.0.0/N" | grep -Eo '[0-9]+\.[0-9]+\.[0-9]+' | head -n1 || true)
  [[ -n "$version" ]] || { printf '%s\n' "could not determine 1Password CLI version" >&2; return 1; }
  version="v${version}"
  zip_url="https://cache.agilebits.com/dist/1P/op2/pkg/${version}/op_linux_${arch}_${version}.zip"
  dest="$HOME/.local/bin/op"
  tmpdir=$(mktemp -d)
  trap 'rm -rf "$tmpdir"' RETURN
  curl -fsSL "$zip_url" -o "$tmpdir/op.zip" \
    && unzip -qo "$tmpdir/op.zip" -d "$tmpdir" \
    && mv "$tmpdir/op" "$dest" && chmod +x "$dest"
}

install() {
  if command -v op >/dev/null 2>&1; then
    return 0
  fi
  source "$NAS_BACKUP_ROOT/scripts/deps.sh" || true
  deps_ensure_pacman unzip

  mkdir -p "$HOME/.local/bin"
  export PATH="$HOME/.local/bin:$PATH"

  local arch version zip_url dest
  arch=$(_deps_arch_map)
  version=$(curl -fsSL "https://app-updates.agilebits.com/check/1/0/CLI2/en/2.0.0/N" | grep -Eo '[0-9]+\.[0-9]+\.[0-9]+' | head -n1 || true)
  [[ -n "$version" ]] || {
    printf '%s\n' "could not determine 1Password CLI version" >&2
    return 1
  }
  version="v${version}"
  zip_url="https://cache.agilebits.com/dist/1P/op2/pkg/${version}/op_linux_${arch}_${version}.zip"
  dest="$HOME/.local/bin/op"

  deps_curl_install \
    "1Password CLI (${version})" \
    "tmpdir=\$(mktemp -d) && curl -fsSL '${zip_url}' -o \"\$tmpdir/op.zip\" && unzip -qo \"\$tmpdir/op.zip\" -d \"\$tmpdir\" && mv \"\$tmpdir/op\" '${dest}' && chmod +x '${dest}' && rm -rf \"\$tmpdir\""
}

put() {
  printf '%s\n' "1password backend does not write items; create the item in 1Password" >&2
  exit 2
}

case "$cmd" in
  id) id ;;
  describe) describe ;;
  available) available ;;
  setup) setup ;;
  get) get ;;
  unlock) unlock ;;
  update) update ;;
  put) put ;;
  install) install ;;
  *) printf 'unknown verb: %s\n' "$cmd" >&2; exit 2 ;;
esac
