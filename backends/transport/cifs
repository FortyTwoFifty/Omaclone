#!/usr/bin/env bash
set +x +v
set -euo pipefail

source "$NAS_BACKUP_ROOT/scripts/transport-lib.sh"

id() { printf '%s\n' cifs; }
describe() { printf '%s\n' "SMB/CIFS (Synology, TrueNAS, Samba, …)"; }

install() {
  if command -v mount.cifs >/dev/null 2>&1; then return 0; fi
  source "$NAS_BACKUP_ROOT/scripts/deps.sh" || true
  deps_ensure_pacman cifs-utils mount.cifs
}

available() { command -v mount.cifs >/dev/null 2>&1; }

capabilities() { printf '%s\n' "mount"; }
credential_keys() { printf '%s\n' "smb-password"; }

ensure_cifs_utils() {
  if command -v mount.cifs >/dev/null 2>&1; then
    return 0
  fi
  echo "Installing cifs-utils…" >&2
  sudo pacman -S --needed --noconfirm cifs-utils
}

_cifs_shred_cred() {
  local f="${1:-}"
  [[ -n "$f" && -e "$f" ]] || return 0
  if command -v shred >/dev/null 2>&1; then
    shred -u "$f" 2>/dev/null || rm -f "$f"
  else
    : >"$f"
    rm -f "$f"
  fi
}

_cifs_write_cred() {
  local user="$1" cred="$2"
  {
    printf 'username=%s\n' "$user"
    printf 'password='
    transport_secret_get smb-password
    printf '\n'
  } >"$cred"
  chmod 600 "$cred"
}

_cifs_probe() {
  local uri="$1" user="$2"
  local tmp cred rc=0
  tmp=$(mktemp -d /tmp/omaclone-cifs-probe.XXXXXX)
  cred=$(_smb_cred_file) || { rmdir "$tmp" 2>/dev/null || true; return 1; }
  _cifs_write_cred "$user" "$cred" || { _cifs_shred_cred "$cred"; rmdir "$tmp"; return 1; }
  if command -v timeout >/dev/null 2>&1; then
    timeout 15 sudo_noninteractive mount -t cifs "$uri" "$tmp" \
      -o "credentials=${cred},ro,vers=3.0,nosuid,nodev,noexec,_netdev" || rc=$?
  else
    sudo_noninteractive mount -t cifs "$uri" "$tmp" \
      -o "credentials=${cred},ro,vers=3.0,nosuid,nodev,noexec,_netdev" || rc=$?
  fi
  sudo_noninteractive umount -l "$tmp" 2>/dev/null || true
  _cifs_shred_cred "$cred"
  rmdir "$tmp" 2>/dev/null || true
  return "$rc"
}

_smb_cred_file() {
  local dir
  if [[ -d /dev/shm && -w /dev/shm ]]; then
    dir=/dev/shm
  elif [[ -d /run/user/${UID:-$(command id -u)} && -w /run/user/${UID:-$(command id -u)} ]]; then
    dir="/run/user/${UID:-$(command id -u)}"
  else
    printf '%s\n' "no tmpfs directory for SMB credentials" >&2
    return 1
  fi
  local f
  f=$(mktemp -p "$dir" omaclone.smb.XXXXXX)
  chmod 600 "$f"
  printf '%s\n' "$f"
}

setup() {
  ensure_cifs_utils
  source "$NAS_BACKUP_ROOT/scripts/lib.sh"
  source "$NAS_BACKUP_ROOT/scripts/nfs-lib.sh"

  local uri mountpoint user
  uri=$(cfg transport.uri "")
  mountpoint=$(cfg transport.mountpoint /mnt/omaclone)
  user=$(cfg transport.username "$USER")
  tui_brief_file cifs
  uri=$(gum_input "UNC path (//server/share)" "$uri")
  mountpoint=$(gum_input "Local mountpoint" "$mountpoint")
  user=$(gum_input "SMB username" "$user")
  cifs_validate_unc "$uri" || exit 1
  nfs_validate_mountpoint "$mountpoint" || exit 1
  [[ -n "$user" ]] || { printf '%s\n' "SMB username is required" >&2; exit 1; }

  if ! transport_secret_get smb-password >/dev/null; then
    echo "Store the SMB password in the keyring (not in config)." >&2
    transport_secret_prompt_and_store smb-password "SMB password for $user" || exit 1
  elif command -v gum >/dev/null 2>&1 && gum confirm "Replace the stored SMB password?"; then
    transport_secret_prompt_and_store smb-password "SMB password for $user" || exit 1
  fi

  printf '%s\n' "Checking that $uri is reachable before saving this location…" >&2
  if ! _cifs_probe "$uri" "$user"; then
    printf '%s\n' "SMB share is not available (wrong UNC, user, or password)." >&2
    exit 1
  fi

  cfg_set transport.backend cifs
  cfg_set transport.uri "$uri"
  cfg_set transport.mountpoint "$mountpoint"
  cfg_set transport.username "$user"
  cfg_set restic.repo "${mountpoint%/}/omaclone/repo"
}

mount() {
  ensure_cifs_utils
  source "$NAS_BACKUP_ROOT/scripts/lib.sh"

  local uri mountpoint user cred
  uri=$(cfg transport.uri)
  mountpoint=$(cfg transport.mountpoint /mnt/omaclone)
  user=$(cfg transport.username "$USER")
  if mount_is_type "$mountpoint" cifs; then
    exit 0
  fi
  sudo_noninteractive mkdir -p "$mountpoint" || exit 1
  cred=$(_smb_cred_file)
  trap '_cifs_shred_cred "'"$cred"'"' EXIT INT TERM HUP
  _cifs_write_cred "$user" "$cred"
  local rc=0
  sudo_noninteractive mount -t cifs "$uri" "$mountpoint" \
    -o "credentials=${cred},uid=$(command id -u),gid=$(command id -g),file_mode=0600,dir_mode=0700,vers=3.0,nosuid,nodev,noexec,_netdev" \
    || rc=$?
  _cifs_shred_cred "$cred"
  trap - EXIT INT TERM HUP
  exit "$rc"
}

unmount() {
  local mountpoint
  mountpoint=$(cfg transport.mountpoint /mnt/omaclone)
  sudo_noninteractive umount "$mountpoint" 2>/dev/null || true
}

ready() {
  local mountpoint repo
  mountpoint=$(cfg transport.mountpoint /mnt/omaclone)
  repo=$(cfg restic.repo)
  [[ -n "$repo" ]] || return 1
  mount_is_type "$mountpoint" cifs
}

bootstrap-install() {
  ready || mount
  source "$NAS_BACKUP_ROOT/scripts/lib.sh"
  python3 "$NAS_BACKUP_ROOT/scripts/bootstrap_copy.py" "$NAS_BACKUP_ROOT" "$(omaclone_kit_dir "$(cfg transport.mountpoint /mnt/omaclone)")" "$NAS_BACKUP_CONFIG"
}

dispatch_transport "${1:-}"
