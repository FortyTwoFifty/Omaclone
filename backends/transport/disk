#!/usr/bin/env bash
set +x +v
set -euo pipefail

source "$NAS_BACKUP_ROOT/scripts/transport-lib.sh"

id() { printf '%s\n' disk; }
describe() { printf '%s\n' "Extra disk (USB, 2nd drive, hybrid)"; }
available() { exit 0; }
capabilities() { printf '%s\n' "mount removable discover"; }

_disk_uuid_src() {
  local uuid="$1"
  omaclone_disk_uuid_ok "$uuid" || {
    printf '%s\n' "invalid disk UUID" >&2
    return 1
  }
  printf '%s/%s\n' "${OMACLONE_DISK_BY_UUID_DIR:-/dev/disk/by-uuid}" "$uuid"
}

_disk_json_get() {
  python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get(sys.argv[2]) or "")' "$1" "$2"
}

_disk_is_removable() {
  local rec="$1" tran hotplug
  tran=$(_disk_json_get "$rec" tran)
  hotplug=$(_disk_json_get "$rec" hotplug)
  [[ "$tran" == usb || "$hotplug" == True || "$hotplug" == true || "$hotplug" == 1 ]]
}

_disk_mount_options() {
  local fstype="${1:-auto}"
  local opts="noatime,nosuid,nodev,noexec"
  case "${fstype,,}" in
    vfat|exfat|ntfs|ntfs3|msdos|fuseblk)
      opts="$opts,uid=$(command id -u),gid=$(command id -g)"
      ;;
  esac
  printf '%s\n' "$opts"
}

_pick_device() {
  local lines=() rec line label
  while IFS= read -r rec; do
    [[ -z "$rec" ]] && continue
    line=$(python3 -c '
import json,sys
d=json.loads(sys.argv[1])
bits=[d["path"], d.get("size") or "?", d.get("fstype") or "no-fs"]
if d.get("label"): bits.append(d["label"])
if d.get("model"): bits.append(d["model"])
if d.get("tran"): bits.append(d["tran"])
if d.get("mountpoint"): bits.append("at "+d["mountpoint"])
print("  ".join(bits))
' "$rec")
    lines+=("$line|$rec")
  done < <(python3 "$NAS_BACKUP_ROOT/scripts/disk_candidates.py")
  if ((${#lines[@]} == 0)); then
    printf '%s\n' "no extra disks found (the Omarchy system disk is never offered)" >&2
    return 1
  fi
  if ! have_cmd gum; then
    printf '%s\n' "${lines[0]#*|}"
    return 0
  fi
  local choices=()
  local l
  for l in "${lines[@]}"; do
    choices+=("${l%%|*}")
  done
  local picked
  picked=$(printf '%s\n' "${choices[@]}" | gum choose --header="Which disk should hold the backup?") || return 1
  for l in "${lines[@]}"; do
    if [[ "${l%%|*}" == "$picked" ]]; then
      printf '%s\n' "${l#*|}"
      return 0
    fi
  done
  return 1
}

_format_device() {
  local rec="$1" label="${2:-}"
  local path majmin bytes by_id serial pkname phrase
  path=$(_disk_json_get "$rec" path)
  majmin=$(_disk_json_get "$rec" majmin)
  bytes=$(_disk_json_get "$rec" bytes)
  by_id=$(_disk_json_get "$rec" by_id)
  serial=$(_disk_json_get "$rec" serial)
  pkname=$(_disk_json_get "$rec" pkname)
  [[ -n "$path" && -n "$majmin" && -n "$bytes" && -n "$by_id" ]] || {
    printf '%s\n' "refusing to format without a stable by-id device identity" >&2
    return 1
  }
  if ! have_cmd gum; then
    printf '%s\n' "refusing to format $path without gum confirmation" >&2
    return 1
  fi
  omaclone_privileged_load || return 1
  gum style --foreground 196 "This will ERASE $path and create an ext4 filesystem."
  if ! gum confirm "Format $path as ext4?"; then
    return 1
  fi
  phrase=$(gum input --placeholder "Type DESTROY to erase $path" </dev/tty)
  [[ "$phrase" == DESTROY ]] || { printf '%s\n' "aborted" >&2; return 1; }
  omaclone_privileged format-disk \
    --path "$path" \
    --majmin "$majmin" \
    --bytes "$bytes" \
    --by-id "$by_id" \
    --serial "$serial" \
    --pkname "$pkname" \
    --label "$label"
}

setup() {
  source "$NAS_BACKUP_ROOT/scripts/lib.sh"

  local rec path uuid fstype mountpoint label
  rec=$(_pick_device) || exit 1
  path=$(_disk_json_get "$rec" path)
  uuid=$(_disk_json_get "$rec" uuid)
  fstype=$(_disk_json_get "$rec" fstype)
  label=$(_disk_json_get "$rec" label)

  if [[ -n "$fstype" && -n "$uuid" ]]; then
    case "${fstype,,}" in
      vfat|exfat|ntfs|ntfs3|msdos|fuseblk)
        echo "FAT/exFAT/NTFS is writable (uid=/gid=) but a poor choice for large clones. Prefer ext4, btrfs, or xfs." >&2
        ;;
    esac
    if have_cmd gum; then
      gum confirm "Use $path ($fstype${label:+, $label}) for clones? Existing files will not be erased." || exit 1
    fi
  else
    echo "No filesystem on $path." >&2
    label=$(gum input --placeholder "Volume label (default Omaclone)" --value "$label" </dev/tty)
    _format_device "$rec" "$label" || exit 1
    rec=$(python3 "$NAS_BACKUP_ROOT/scripts/disk_candidates.py" | python3 -c '
import json,sys
want=sys.argv[1]
for line in sys.stdin:
    d=json.loads(line)
    if d.get("path")==want:
        print(line.strip()); break
' "$path")
    uuid=$(_disk_json_get "$rec" uuid)
    fstype=$(_disk_json_get "$rec" fstype)
    [[ -n "$fstype" ]] || fstype=ext4
    [[ -n "$uuid" ]] || { printf '%s\n' "format did not produce a UUID" >&2; exit 1; }
  fi

  mountpoint=$(cfg transport.mountpoint "")
  local removable=0
  _disk_is_removable "$rec" && removable=1
  if (( removable )); then
    # USB / hotplug: mount with udisks while cloning. A fixed path is opt-in.
    if have_cmd gum && gum confirm --default=false "Use a fixed mountpoint (always-plugged extra disk)?"; then
      mountpoint=$(gum_input "Mountpoint for this disk" "${mountpoint:-/mnt/omaclone}")
      mountpoint=$(omaclone_validate_mountpoint "$mountpoint") || exit 1
    else
      mountpoint=""
    fi
  else
    mountpoint=$(gum_input "Mountpoint for this disk (empty = desktop mount)" "$mountpoint")
    if [[ -n "$mountpoint" ]]; then
      mountpoint=$(omaclone_validate_mountpoint "$mountpoint") || exit 1
    fi
  fi

  cfg_set transport.backend disk
  cfg_set transport.uuid "$uuid"
  cfg_set transport.device "$path"
  cfg_set transport.fstype "$fstype"
  cfg_set transport.mountpoint "$mountpoint"
  # Removable stays cold (timer off, unmount after clone) even with a preferred
  # path, unless the user installs a systemd mount unit below.
  if (( removable )) || [[ -z "$mountpoint" ]]; then
    cfg_set transport.mode cold
  else
    cfg_set transport.mode hot
  fi
  if [[ -n "$mountpoint" ]]; then
    cfg_set restic.repo "${mountpoint%/}/omaclone/repo"
  fi

  if ! _disk_attach; then
    printf '%s\n' "could not mount $path — plug it in, or leave the mountpoint empty to use the desktop (udisks) mount." >&2
    exit 1
  fi
  if [[ -n "$mountpoint" ]] && have_cmd gum && gum confirm --default=false "Install a systemd mount so this disk appears at $mountpoint when plugged in?"; then
    "$NAS_BACKUP_ROOT/scripts/install-disk-mount.sh" "$uuid" "$mountpoint" "$fstype" || {
      printf '%s\n' "systemd mount was not installed; clones will still use the live mount." >&2
    }
    cfg_set transport.mode hot
  fi
}

_disk_own() {
  local path="$1"
  [[ -n "$path" ]] || return 0
  if mkdir -p "$path" 2>/dev/null && [[ -w "$path" ]]; then
    return 0
  fi
  sudo_noninteractive mkdir -p "$path" || return 1
  if sudo_noninteractive chown "$(command id -u):$(command id -g)" "$path" 2>/dev/null; then
    return 0
  fi
  # exFAT/vfat cannot chown; uid= on the mount is enough if the path is writable.
  [[ -w "$path" ]]
}

_disk_bind_repo() {
  local live_target="$1" kit repo
  [[ -n "$live_target" ]] || return 1
  source "$NAS_BACKUP_ROOT/scripts/lib.sh"
  kit=$(omaclone_kit_dir "$live_target")
  repo="$kit/repo"
  cfg_set restic.repo "$repo"
  _disk_own "$kit"
  _disk_own "$repo"
}

_disk_find_live() {
  local src="$1" mountpoint="${2:-}" target source want got
  want=$(readlink -f "$src" 2>/dev/null || printf '%s' "$src")
  if [[ -n "$mountpoint" ]]; then
    target=$(findmnt -n -o TARGET "$mountpoint" 2>/dev/null | head -n 1 || true)
    source=$(findmnt -n -o SOURCE "$mountpoint" 2>/dev/null | head -n 1 || true)
    if [[ "$target" == "$mountpoint" && -n "$source" ]]; then
      got=$(readlink -f "$source" 2>/dev/null || printf '%s' "$source")
      if [[ "$source" == "$src" || "$got" == "$want" ]]; then
        printf '%s\n' "$mountpoint"
        return 0
      fi
    fi
  fi
  findmnt -n -o TARGET -S "$src" 2>/dev/null | head -n 1 || true
}

_disk_udisks_mount() {
  local src="$1"
  have_cmd udisksctl || return 1
  udisksctl mount -b "$src" >/dev/null 2>&1
}

_disk_mount_at() {
  local src="$1" dest="$2" fstype="$3" opts resolved
  [[ -n "$dest" ]] || return 1
  resolved=$(omaclone_validate_mountpoint "$dest") || return 1
  dest="$resolved"
  opts=$(_disk_mount_options "$fstype")
  sudo_tty mkdir -p "$dest" || return 1
  sudo_tty mount -t "$fstype" -o "$opts" -- "$src" "$dest"
}

_disk_attach() {
  local uuid mountpoint fstype live_target src
  uuid=$(cfg transport.uuid)
  mountpoint=$(cfg transport.mountpoint "")
  fstype=$(cfg transport.fstype auto)
  [[ -n "$uuid" ]] || { printf '%s\n' "transport.uuid is empty" >&2; return 1; }

  src=$(_disk_uuid_src "$uuid")
  live_target=$(_disk_find_live "$src" "$mountpoint")
  if [[ -n "$live_target" ]]; then
    _disk_bind_repo "$live_target"
    if [[ -n "$mountpoint" && "$live_target" != "$mountpoint" ]]; then
      printf '%s\n' "disk is mounted at $live_target (requested $mountpoint)" >&2
    fi
    return 0
  fi

  if [[ ! -e "$src" ]]; then
    printf '%s\n' "backup disk UUID $uuid is not connected" >&2
    return 1
  fi

  if [[ -n "$mountpoint" ]]; then
    if ! _disk_mount_at "$src" "$mountpoint" "$fstype"; then
      printf '%s\n' "could not mount at $mountpoint (sudo mount failed); trying desktop mount" >&2
      _disk_udisks_mount "$src" || true
    fi
  elif have_cmd udisksctl; then
    _disk_udisks_mount "$src" || { printf '%s\n' "udisksctl mount failed for $src" >&2; return 1; }
  else
    printf '%s\n' "no mountpoint configured and udisksctl unavailable" >&2
    return 1
  fi

  live_target=$(_disk_find_live "$src" "$mountpoint")
  if [[ -z "$live_target" ]]; then
    printf '%s\n' "backup disk UUID $uuid is connected but not mounted" >&2
    return 1
  fi
  _disk_bind_repo "$live_target"
  if [[ -n "$mountpoint" && "$live_target" != "$mountpoint" ]]; then
    printf '%s\n' "using $live_target for clones (could not mount $mountpoint)" >&2
  fi
  return 0
}

mount() {
  _disk_attach || exit 1
}

unmount() {
  local uuid mountpoint src live
  [[ "$(cfg transport.mode)" == cold ]] || return 0
  uuid=$(cfg transport.uuid)
  mountpoint=$(cfg transport.mountpoint "")
  src=$(_disk_uuid_src "$uuid")
  live=$(findmnt -n -o TARGET -S "$src" 2>/dev/null | head -n 1 || true)
  [[ -n "$live" ]] || return 0
  if [[ -n "$mountpoint" ]]; then
    sudo_noninteractive umount "$live" 2>/dev/null || true
  elif have_cmd udisksctl; then
    udisksctl unmount -b "$src" >/dev/null 2>&1 || true
  fi
}

ready() {
  local uuid live_target src
  uuid=$(cfg transport.uuid)
  [[ -n "$uuid" ]] || return 1
  src=$(_disk_uuid_src "$uuid")
  [[ -e "$src" ]] || return 1
  live_target=$(findmnt -n -o TARGET -S "$src" 2>/dev/null | head -n 1 || true)
  [[ -n "$live_target" ]]
}

pre_restic() {
  mount
}

post_restic() {
  unmount
}

discover() {
  python3 "$NAS_BACKUP_ROOT/scripts/discover_bootstrap.py"
}

bootstrap-install() {
  ready || mount
  local target dest src
  src=$(_disk_uuid_src "$(cfg transport.uuid)")
  target=$(findmnt -n -o TARGET -S "$src" 2>/dev/null | head -n 1 || true)
  [[ -z "$target" ]] && target="$(cfg transport.mountpoint /mnt/omaclone)"
  source "$NAS_BACKUP_ROOT/scripts/lib.sh"
  dest=$(omaclone_kit_dir "$target")
  python3 "$NAS_BACKUP_ROOT/scripts/bootstrap_copy.py" "$NAS_BACKUP_ROOT" "$dest" "$NAS_BACKUP_CONFIG"
}

dispatch_transport "${1:-}"
