[Unit]
Description=Omaclone clone when the keyring unlocks
After=graphical-session.target
Conflicts=omaclone.service omaclone-prune.service

[Service]
Type=oneshot
TimeoutStartSec=21h
NoNewPrivileges=yes
PrivateTmp=yes
# true (not strict): wait-keyring then clones; same write paths as omaclone.service.
ProtectSystem=true
RestrictSUIDSGID=yes
LockPersonality=yes
ExecStart=%h/.local/bin/omaclone wait-keyring
Nice=10
IOSchedulingClass=idle
