[Unit]
Description=Omaclone clone when the keyring unlocks
After=graphical-session.target
Conflicts=omaclone.service omaclone-prune.service

[Service]
Type=oneshot
TimeoutStartSec=21h
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
RestrictSUIDSGID=yes
LockPersonality=yes
ExecStart=%h/.local/bin/omaclone wait-keyring
Nice=10
IOSchedulingClass=idle
