[Unit]
Description=Prune Omaclone restic snapshots
After=network-online.target
Wants=network-online.target
Conflicts=omaclone.service omaclone-keyring-retry.service

[Service]
Type=oneshot
TimeoutStartSec=2h
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
RestrictSUIDSGID=yes
LockPersonality=yes
ExecStart=%h/.local/bin/omaclone prune --cron
