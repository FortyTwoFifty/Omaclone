[Unit]
Description=Prune Omaclone restic snapshots
After=network-online.target
Wants=network-online.target
Conflicts=omaclone.service omaclone-keyring-retry.service

[Service]
Type=oneshot
TimeoutStartSec=2h
NoNewPrivileges=yes
PrivateTmp=yes
# true (not strict): strict remounts /mnt and /run/media read-only.
ProtectSystem=true
RestrictSUIDSGID=yes
LockPersonality=yes
ExecStart=%h/.local/bin/omaclone prune --cron
