[Unit]
Description=Omaclone identity clone
After=network-online.target
Wants=network-online.target
Conflicts=omaclone-prune.service

[Service]
Type=oneshot
TimeoutStartSec=6h
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
RestrictSUIDSGID=yes
LockPersonality=yes
ExecStart=%h/.local/bin/omaclone clone --cron
Nice=10
IOSchedulingClass=idle
