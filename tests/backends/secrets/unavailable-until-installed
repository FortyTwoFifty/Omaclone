#!/usr/bin/env bash
set +x +v
set -euo pipefail
cmd="${1:-}"

_marker_file=""

id() { printf '%s\n' unavailable-until-installed; }
describe() { printf '%s\n' "Test: unavailable until installed"; }

available() {
  [[ -n "${NAS_BACKUP_USER_CONFIG_DIR:-}" ]] || exit 0
  _marker_file="${NAS_BACKUP_USER_CONFIG_DIR}/.uninstalled-marker"
  [[ -f "$_marker_file" ]] || exit 1
}

setup() { exit 0; }

install() {
  mkdir -p "${NAS_BACKUP_USER_CONFIG_DIR:-/tmp}"
  touch "${NAS_BACKUP_USER_CONFIG_DIR}/.uninstalled-marker"
  return 0
}

get() { printf '%s' "unavailable-until-installed-password"; }
put() { exit 2; }
unlock() { exit 2; }

case "$cmd" in
  id) id ;;
  describe) describe ;;
  available) available ;;
  install) install ;;
  setup) setup ;;
  get) get ;;
  unlock) unlock ;;
  put) put ;;
  *) exit 2 ;;
esac
