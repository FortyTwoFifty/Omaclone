#!/usr/bin/env bash
set +x +v
set -euo pipefail
cmd="${1:-}"
id() { printf '%s\n' dummy; }
describe() { printf '%s\n' "Test dummy (not for production)"; }
available() { exit 0; }
setup() { exit 0; }
install() { return 0; }

get() { printf '%s' "dummy-password-not-for-real-repos"; }
put() { exit 2; }

unlock() { exit 2; }

case "$cmd" in
  id) id ;;
  describe) describe ;;
  available) available ;;
  install) install ;;
  setup) setup ;;
  get) get ;;
  unlock) unlock ;;
  put) put ;;
  brief) exit 0 ;;
  *) exit 2 ;;
esac
