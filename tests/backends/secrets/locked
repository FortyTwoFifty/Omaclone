#!/usr/bin/env bash
set +x +v
set -euo pipefail
cmd="${1:-}"
id() { printf '%s\n' locked; }
describe() { printf '%s\n' "Test locked secrets (get always fails)"; }
available() { exit 0; }
setup() { exit 0; }
install() { return 0; }
get() { printf '%s\n' "keyring is locked" >&2; exit 1; }
put() { exit 2; }
unlock() { exit 2; }

case "$cmd" in
  id) id ;;
  describe) describe ;;
  available) available ;;
  install) install ;;
  setup) setup ;;
  get) get ;;
  unlock) unlock ;;
  put) put ;;
  *) exit 2 ;;
esac
